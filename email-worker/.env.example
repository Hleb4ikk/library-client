# Подключение к Redis (та же инстанция, что использует сервер для очереди)
REDIS_URL=redis://default:my_secure_password@localhost:6379

# Имя очереди BullMQ (должно совпадать с продюсером на сервере)
EMAIL_QUEUE_NAME=email-queue
# Сколько задач воркер обрабатывает параллельно
WORKER_CONCURRENCY=5

# SMTP-сервер для отправки писем
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
MAIL_FROM=no-reply@library.local
